{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "kubernetes-dashboard": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "baseHref": ""
        },
        "locales": {
          "de": {
            "translation": "i18n/de/messages.de.xlf",
            "baseHref": ""
          },
          "es": {
            "translation": "i18n/es/messages.es.xlf",
            "baseHref": ""
          },
          "fr": {
            "translation": "i18n/fr/messages.fr.xlf",
            "baseHref": ""
          },
          "ja": {
            "translation": "i18n/ja/messages.ja.xlf",
            "baseHref": ""
          },
          "ko": {
            "translation": "i18n/ko/messages.ko.xlf",
            "baseHref": ""
          },
          "zh-Hans": {
            "translation": "i18n/zh-Hans/messages.zh-Hans.xlf",
            "baseHref": ""
          },
          "zh-Hant": {
            "translation": "i18n/zh-Hant/messages.zh-Hant.xlf",
            "baseHref": ""
          },
          "zh-Hant-HK": {
            "translation": "i18n/zh-Hant-HK/messages.zh-Hant-HK.xlf",
            "baseHref": ""
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "optimization": false,
            "progress": true,
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["src/polyfills.ts", "@angular/localize/init"],
            "i18nMissingTranslation": "error",
            "allowedCommonJsDependencies": ["truncate-url", "strip-ansi"],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "robots.txt",
                "input": "src/assets",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ace-builds/src-min-noconflict",
                "output": "/ace"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            },
            "styles": [
              "node_modules/material-design-icons/iconfont/material-icons.css",
              "node_modules/roboto-fontface/css/roboto/roboto-fontface.css",
              "node_modules/@xterm/xterm/css/xterm.css",
              "node_modules/@angular/material/prebuilt-themes/deeppurple-amber.css",
              "src/index.scss"
            ],
            "scripts": [
              "node_modules/sockjs-client/dist/sockjs.min.js",
              "node_modules/systemjs/dist/s.js",
              "node_modules/systemjs/dist/extras/named-register.js",
              "node_modules/systemjs/dist/extras/amd.js"
            ],
            "browser": "src/index.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "aot": true,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "localize": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 8080,
            "buildTarget": "kubernetes-dashboard:build"
          }
        },
        "extract-i18n-merge": {
          "builder": "ng-extract-i18n-merge:ng-extract-i18n-merge",
          "options": {
            "buildTarget": "kubernetes-dashboard:build",
            "format": "xlf",
            "outputPath": "i18n",
            "targetFiles": [
              "de/messages.de.xlf",
              "es/messages.es.xlf",
              "fr/messages.fr.xlf",
              "ja/messages.ja.xlf",
              "ko/messages.ko.xlf",
              "zh-Hans/messages.zh-Hans.xlf",
              "zh-Hant/messages.zh-Hant.xlf",
              "zh-Hant-HK/messages.zh-Hant-HK.xlf"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "kd",
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "kd",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false
  }
}
