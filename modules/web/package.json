    "minimatch@^10.2.4": "patch:minimatch@npm%3A10.2.6#./.yarn/patches/minimatch-npm-10.2.6-fd0d1cf467.patch",
    "minimatch@^10.2.6": "patch:minimatch@npm%3A10.2.6#./.yarn/patches/minimatch-npm-10.2.6-fd0d1cf467.patch",
