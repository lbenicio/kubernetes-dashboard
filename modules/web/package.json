{
  "name": "kubernetes-dashboard",
  "version": "2.7.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubernetes/dashboard.git"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "engineStrict": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "postinstall": "sh ./hack/postinstall.sh",
    "start": "make -C ../.. serve",
    "start:https": "make serve-https",
    "build:prod": "make build",
    "fix": "yarn fix:i18n && yarn fix:html && yarn fix:scss && yarn fix:ts",
    "fix:i18n": "ng run kubernetes-dashboard:extract-i18n-merge",
    "fix:html": "prettier **.html --ignore-path ../../.gitignore --write",
    "fix:scss": "stylelint **/*.{css,scss} --ignore-path ../../.gitignore --fix",
    "fix:ts": "eslint . --fix",
    "check": "yarn check:i18n && yarn check:html && yarn check:scss && yarn check:ts",
    "check:i18n": "yarn fix:i18n",
    "check:html": "prettier **.html --ignore-path ../../.gitignore --check",
    "check:scss": "stylelint **/*.{css,scss} --ignore-path ../../.gitignore",
    "check:ts": "eslint .",
    "test": "npx jest -c jest.config.js",
    "coverage": "npx jest -c jest.config.js --coverage",
    "cypress": "wait-on -v -t 600000 -i 1000 http-get://127.0.0.1:8080/config http-get://127.0.0.1:8080 && npx cypress run",
    "e2e": "concurrently -kill-others --success first \"yarn start\" \"yarn cypress\"",
    "e2e:headed": "concurrently -kill-others --success first \"yarn start\" \"wait-on -t 600000 -i 1000 http-get://127.0.0.1:8080/config http-get://127.0.0.1:8080 && npx cypress run --headed\"",
    "analyze": "ng build --stats-json && esbuild-visualizer --metadata dist/browser-stats.json --filename dist/stats.html"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "src/**/*.scss": [
      "stylelint --fix"
    ],
    "src/**/*.html": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
