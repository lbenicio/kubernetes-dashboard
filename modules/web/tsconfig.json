{
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false
  },
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "paths": {
      "@api/*": ["./src/typings/*"],
      "@common/*": ["./src/common/*"],
      "@environments/*": ["./src/environments/*"],
      "assets/*": ["./src/assets/*"],
      "chrome/*": ["./src/chrome/*"],
      "common/*": ["./src/common/*"],
      "crd/*": ["./src/crd/*"],
      "create/*": ["./src/create/*"],
      "environments/*": ["./src/environments/*"],
      "error/*": ["./src/error/*"],
      "login/*": ["./src/login/*"],
      "logs/*": ["./src/logs/*"],
      "overview/*": ["./src/overview/*"],
      "resource/*": ["./src/resource/*"],
      "search/*": ["./src/search/*"],
      "settings/*": ["./src/settings/*"],
      "shell/*": ["./src/shell/*"],
      "typings/*": ["./src/typings/*"]
    },
    "outDir": ".tmp/out-tsc",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ES2022",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false
  }
}
